<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/org.kb10uy.zatools/Editor/Ndmf/Inspector/InspectorCommon.uss?fileID=7433441132597879392&amp;guid=c87deba29c7e8b643a69a6f5981f99ca&amp;type=3#InspectorCommon" />
    <ui:VisualElement style="flex-grow: 1;">
        <nadena.dev.ndmf.ui.LanguageSwitcher class="zatools-language-switcher" />
        <ui:VisualElement class="zatools-section">
            <ui:Toggle name="FieldReplace" binding-path="Replace" label="ahbsm.inspector.replace" class="ndmf-tr" />
            <ui:VisualElement class="zatools-block" style="flex-grow: 1; flex-direction: row; padding-left: 32px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 0; border-left-width: 1px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-left-color: rgb(26, 26, 26); border-right-color: rgb(26, 26, 26); border-top-color: rgb(26, 26, 26); border-bottom-color: rgb(26, 26, 26); background-color: rgb(53, 53, 53); margin-top: 4px; padding-bottom: 6px; margin-bottom: -4px; padding-top: 2px;">
                <ui:Label tabindex="-1" text="ahbsm.inspector.from" parse-escape-sequences="true" display-tooltip-when-elided="true" name="LabelFrom" class="ndmf-tr" style="flex-grow: 1; flex-basis: 0; margin-right: 16px;" />
                <ui:Label tabindex="-1" text="ahbsm.inspector.to" parse-escape-sequences="true" display-tooltip-when-elided="true" name="LabelTo" class="ndmf-tr" style="flex-basis: 0; flex-grow: 1; margin-right: 16px;" />
                <ui:Label tabindex="-1" text="ahbsm.inspector.weight" parse-escape-sequences="true" display-tooltip-when-elided="true" name="LabelWeight" class="ndmf-tr" style="flex-basis: 0; flex-grow: 1;" />
            </ui:VisualElement>
            <ui:ListView name="FieldMixDefinitions" binding-path="MixDefinitions" virtualization-method="DynamicHeight" reorderable="true" show-add-remove-footer="true" show-bound-collection-size="false" reorder-mode="Animated" show-border="true" show-foldout-header="false" />
        </ui:VisualElement>
        <KusakaFactory.Zatools.Ndmf.Inspector.ZatoolsPreviewSwitcher target-filter-type="KusakaFactory.Zatools.Ndmf.Preview.AhbsmRenderFilter, org.kb10uy.zatools" class="zatools-section" />
        <ui:Foldout text="ahbsm.inspector.manipulation" value="true" class="ndmf-tr zatools-foldout--flush zatools-section">
            <ui:VisualElement class="zatools-row zatools-section">
                <ui:Button text="ahbsm.inspector.save-json" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonSaveToJson" class="ndmf-tr" style="flex-basis: 0; flex-grow: 1;" />
                <ui:Button text="ahbsm.inspector.load-json" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonLoadFromJson" class="ndmf-tr" style="flex-basis: 0; flex-grow: 1;" />
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:TextField picking-mode="Ignore" label="ahbsm.inspector.from-regex" name="FieldFromRegex" class="ndmf-tr" />
                <ui:TextField picking-mode="Ignore" label="ahbsm.inspector.to-regex" name="FieldToRegex" class="ndmf-tr" />
                <ui:Button text="ahbsm.inspector.append-regex" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonAppendWithRegex" class="ndmf-tr zatools-block" />
            </ui:VisualElement>
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
