.unity-base-field__label {
    width: 240px;
}

.label-indent-1 > .unity-base-field__label {
    padding-left: 12px;
}

.label-indent-2 > .unity-base-field__label {
    padding-left: 24px;
}

.label-indent-1 > .zax-expression__input > .unity-base-field__label {
    padding-left: 12px;
}

.zax-expression__status {
    padding-left: 246px;
    white-space: normal;
}

.zax-expression__status--error {
    color: var(--unity-colors-error-text);
}

.zax-expression__variables {
    padding-left: 246px;
    white-space: normal;
    opacity: 0.6;
}

.unity-help-box,
.unity-list-view,
.zatools-block,
.zatools-language-switcher,
.zatools-section__heading,
.zatools-note {
    margin-left: 3px;
    margin-right: -2px;
}

.zatools-language-switcher {
    margin-bottom: 8px;
}

.zatools-section {
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.zatools-section__heading {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.zatools-note {
    white-space: normal;
    opacity: 0.6;
}

.zatools-note--separated {
    margin-top: 4px;
}

.zatools-row {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    margin-left: 2px;
    margin-right: -3px;
}

.zatools-row > * {
    margin-left: 1px;
    margin-right: 1px;
}

.zatools-foldout--flush > .unity-foldout__content {
    margin-left: 0;
}

.zatools-list-item {
    flex-grow: 1;
    flex-basis: auto;
    margin: 2px -2px 2px 3px;
}

.zatools-list-item--row {
    flex-direction: row;
    align-items: stretch;
}

.zatools-list-item__cell {
    flex-direction: row;
    align-items: stretch;
    margin-right: 4px;
}

.zatools-list-item .unity-base-field {
    margin-left: 0;
    margin-right: 0;
}

.zatools-list-item--row .unity-base-field {
    margin-top: 0;
    margin-bottom: 0;
}

.zatools-list-item .unity-base-field__label {
    width: 160px;
}

.zatools-list-item .zax-expression__status,
.zatools-list-item .zax-expression__variables {
    padding-left: 163px;
}

.zatools-picker-button {
    margin: 0;
    padding-left: 4px;
    padding-right: 4px;
}

.ftdi-diagnostic {
    white-space: normal;
    margin-left: 3px;
    color: var(--unity-colors-error-text);
}

.ftdi-summary__heading {
    flex-direction: row;
    margin-top: 2px;
}

.ftdi-summary__heading-title {
    -unity-font-style: bold;
}

.ftdi-summary__heading-value {
    margin-left: 6px;
}

.ftdi-summary__entry {
    padding: 3px 0 3px 8px;
}

.ftdi-summary__entry:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.ftdi-summary__row {
    flex-direction: row;
}

.ftdi-summary__row--continuation {
    padding-left: 32px;
}

.ftdi-summary__cell {
    opacity: 0.6;
    flex-basis: 0;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ftdi-summary__cell--wrap {
    white-space: normal;
}

.ftdi-summary__index {
    flex-basis: 32px;
    flex-shrink: 0;
}
