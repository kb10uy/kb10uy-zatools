<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/org.kb10uy.zatools/Editor/Ndmf/Inspector/InspectorCommon.uss?fileID=7433441132597879392&amp;guid=c87deba29c7e8b643a69a6f5981f99ca&amp;type=3#InspectorCommon" />
    <ui:VisualElement style="flex-grow: 1;">
        <nadena.dev.ndmf.ui.LanguageSwitcher class="zatools-language-switcher" />
        <ui:Foldout text="ahabss.inspector.sources" name="FoldoutSources" view-data-key="ahabss-foldout-sources" value="true" class="ndmf-tr zatools-foldout--flush zatools-section">
            <ui:ListView name="FieldSourceBlendShapes" virtualization-method="DynamicHeight" show-border="true" reorderable="true" show-add-remove-footer="true" show-foldout-header="false" binding-path="SourceBlendShapes" show-bound-collection-size="false" reorder-mode="Animated" />
        </ui:Foldout>
        <ui:Foldout text="ahabss.inspector.entries" name="FoldoutEntries" view-data-key="ahabss-foldout-entries" value="true" class="ndmf-tr zatools-foldout--flush zatools-section">
            <ui:VisualElement class="zatools-section">
                <ui:Label tabindex="-1" text="ahabss.inspector.variables" parse-escape-sequences="true" display-tooltip-when-elided="true" class="ndmf-tr zatools-section__heading" />
                <ui:Label name="LabelVariables" class="zatools-note" />
                <ui:Label text="ahabss.inspector.variables-sources" class="ndmf-tr zatools-note zatools-note--separated" />
                <ui:Label text="ahabss.inspector.result" class="ndmf-tr zatools-note" />
            </ui:VisualElement>
            <ui:ListView name="FieldEntries" virtualization-method="DynamicHeight" show-border="true" reorderable="true" show-add-remove-footer="true" show-foldout-header="false" binding-path="Entries" show-bound-collection-size="false" reorder-mode="Animated" />
        </ui:Foldout>
        <KusakaFactory.Zatools.Ndmf.Inspector.ZatoolsPreviewSwitcher target-filter-type="KusakaFactory.Zatools.Ndmf.Preview.AhabssRenderFilter, org.kb10uy.zatools" class="zatools-section" />
        <ui:Foldout text="ahabss.inspector.manipulation" name="FoldoutManipulation" view-data-key="ahabss-foldout-manipulation" value="true" class="ndmf-tr zatools-foldout--flush zatools-section">
            <ui:VisualElement class="zatools-row">
                <ui:Button text="ahabss.inspector.save-json" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonSaveToJson" class="ndmf-tr" style="flex-basis: 0; flex-grow: 1;" />
                <ui:Button text="ahabss.inspector.load-json" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonLoadFromJson" class="ndmf-tr" style="flex-basis: 0; flex-grow: 1;" />
            </ui:VisualElement>
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
