<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/org.kb10uy.zatools/Editor/Ndmf/Inspector/InspectorCommon.uss?fileID=7433441132597879392&amp;guid=c87deba29c7e8b643a69a6f5981f99ca&amp;type=3#InspectorCommon" />
    <ui:VisualElement style="flex-grow: 1;">
        <nadena.dev.ndmf.ui.LanguageSwitcher class="zatools-language-switcher" />
        <ui:HelpBox message-type="Warning" text="cdw.inspector.warning-mesh-assigned" name="MeshAssignedWarning" class="ndmf-tr" />
        <ui:HelpBox message-type="Warning" text="cdw.inspector.warning-missing-source-mesh" name="MissingSourceMeshWarning" class="ndmf-tr" />
        <ui:VisualElement class="zatools-section">
            <uie:ObjectField label="cdw.inspector.source" name="FieldSourceMeshRenderer" binding-path="SourceMeshRenderer" type="UnityEngine.SkinnedMeshRenderer, UnityEngine.CoreModule" class="ndmf-tr" />
        </ui:VisualElement>
        <ui:Foldout text="cdw.inspector.advanced" value="false" class="ndmf-tr zatools-foldout--flush zatools-section">
            <ui:VisualElement class="zatools-section">
                <uie:ObjectField label="cdw.inspector.material-override" name="FieldMaterialOverride" type="UnityEngine.Material, UnityEngine.CoreModule" binding-path="MaterialOverride" class="ndmf-tr" />
            </ui:VisualElement>
            <ui:VisualElement class="zatools-section">
                <ui:Label tabindex="-1" text="cdw.inspector.overrides" parse-escape-sequences="true" display-tooltip-when-elided="true" name="LabelOverrides" class="ndmf-tr zatools-section__heading" />
                <ui:ListView name="FieldOverrides" binding-path="Overrides" virtualization-method="DynamicHeight" show-border="true" reorderable="true" show-add-remove-footer="true" show-bound-collection-size="false" reorder-mode="Animated" />
            </ui:VisualElement>
        </ui:Foldout>
        <KusakaFactory.Zatools.Ndmf.Inspector.ZatoolsPreviewSwitcher target-filter-type="KusakaFactory.Zatools.Ndmf.Preview.CdwRenderFilter, org.kb10uy.zatools" class="zatools-section" />
    </ui:VisualElement>
</ui:UXML>
