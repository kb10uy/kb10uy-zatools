<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="VisualElement" class="zatools-list-item zatools-list-item--row">
        <ui:VisualElement name="BlendShapeName" class="zatools-list-item__cell" style="flex-grow: 2; flex-shrink: 0;">
            <ui:TextField picking-mode="Ignore" binding-path="Name" name="FieldName" style="flex-grow: 1; flex-basis: 0;" />
            <ui:Button text="..." parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonOpenBlendShapeNamePanel" class="zatools-picker-button" />
        </ui:VisualElement>
        <ui:Slider high-value="1" name="FieldValue" binding-path="Value" low-value="0" show-input-field="true" inverted="false" style="flex-grow: 1; align-self: stretch; flex-basis: 0;" />
    </ui:VisualElement>
</ui:UXML>
