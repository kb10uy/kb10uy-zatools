<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="VisualElement" class="zatools-list-item zatools-list-item--row">
        <ui:VisualElement name="FromBlendShape" class="zatools-list-item__cell" style="flex-grow: 1; flex-shrink: 0;">
            <ui:TextField picking-mode="Ignore" binding-path="FromBlendShape" name="FieldFromBlendShape" style="flex-grow: 1; flex-basis: 0;" />
            <ui:Button text="..." parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonOpenFromBlendShapePanel" class="zatools-picker-button" />
        </ui:VisualElement>
        <ui:VisualElement name="ToBlendShape" class="zatools-list-item__cell" style="flex-grow: 1; flex-shrink: 0;">
            <ui:TextField picking-mode="Ignore" binding-path="ToBlendShape" name="FieldToBlendShape" style="flex-grow: 1; flex-basis: 0;" />
            <ui:Button text="..." parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonOpenToBlendShapePanel" class="zatools-picker-button" />
        </ui:VisualElement>
        <ui:Slider high-value="1" name="FieldMixWeight" binding-path="MixWeight" low-value="-1" show-input-field="true" inverted="false" style="flex-grow: 1; align-self: stretch; flex-basis: 0;" />
    </ui:VisualElement>
</ui:UXML>
