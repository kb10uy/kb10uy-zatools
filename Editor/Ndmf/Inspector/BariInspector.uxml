<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/org.kb10uy.zatools/Editor/Ndmf/Inspector/InspectorCommon.uss?fileID=7433441132597879392&amp;guid=c87deba29c7e8b643a69a6f5981f99ca&amp;type=3#InspectorCommon" />
    <ui:VisualElement style="flex-grow: 1;">
        <nadena.dev.ndmf.ui.LanguageSwitcher class="zatools-language-switcher" />
        <ui:VisualElement class="zatools-section">
            <ui:Toggle name="FieldCloseLoop" label="bari.inspector.close-loop" binding-path="CloseLoop" class="ndmf-tr" />
            <ui:FloatField name="FieldParentOffsetDistance" label="bari.inspector.offset-distance" binding-path="ParentOffsetDistance" class="ndmf-tr" />
        </ui:VisualElement>
        <ui:VisualElement class="zatools-section">
            <ui:Label tabindex="-1" text="bari.inspector.sources" parse-escape-sequences="true" display-tooltip-when-elided="true" name="LabelChainRoots" class="ndmf-tr zatools-section__heading" />
            <ui:ListView name="FieldChainRoots" reorderable="true" show-add-remove-footer="true" binding-path="ChainRoots" show-border="true" header-title="Sources" virtualization-method="DynamicHeight" tooltip="ボーン鎖のリスト" reorder-mode="Animated" show-bound-collection-size="false" show-foldout-header="false" class="ndmf-tr" />
        </ui:VisualElement>
        <ui:Foldout text="bari.inspector.manipulation" value="false" name="FoldoutManipulation" class="ndmf-tr zatools-foldout--flush zatools-section">
            <ui:Button text="bari.inspector.replace-bones" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonReplaceWithChildren" class="ndmf-tr zatools-block" />
            <ui:VisualElement class="zatools-row">
                <ui:Slider high-value="1" name="SliderUpdateAllInfluences" show-input-field="true" style="flex-grow: 2;" />
                <ui:Button text="bari.inspector.update-influence" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ButtonUpdateAllInfluences" class="ndmf-tr" style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
